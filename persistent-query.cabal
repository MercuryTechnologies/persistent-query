cabal-version:      3.0
name:               persistent-query
version:            0.2.1.0
-- synopsis:
-- description:
-- Original code is Apache-2.0; adapted portions retain their upstream licenses.
license:            Apache-2.0 AND MIT AND BSD-3-Clause
license-files:      LICENSE
                    licenses/persistent-qq-MIT.txt
                    licenses/esqueleto-BSD-3-Clause.txt
author:             Alexander Vieth
maintainer:         alexv@mercury.com
-- copyright:
category:           Database
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Database.Persist.Query
                      Database.Persist.Query.Common
                      Database.Persist.Query.Types
                      Database.Persist.Query.TH
                      Database.Persist.Query.WithError
    -- other-modules:
    -- other-extensions:
    build-depends:    base,
                      aeson,
                      containers,
                      haskell-src-meta,
                      transformers,
                      text,
                      persistent,
                      persistent-qq,
                      esqueleto,
                      template-haskell,
                      uuid
    hs-source-dirs:   src
    default-language: GHC2021

test-suite test
  type: exitcode-stdio-1.0
  main-is: test.hs
  hs-source-dirs:
      test
  build-depends:
      base ==4.*
    , containers
    , esqueleto
    , hedgehog
    , hedgehog-quickcheck
    , persistent
    , persistent-query
    , persistent-sqlite
    , text
    , transformers
    , mmorph
  other-modules: Database.Persist.Query.WithErrorTest
                 Database.Persist.Query.CommonTest
                 Database.Persist.Query.CommonCallStackTest
                 Test.Models
                 Test.Utils
  default-language: GHC2021
